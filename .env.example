# Your delivery coordinates. Google Maps -> right-click your address -> click the lat,lon.
BLINKIT_LAT=
BLINKIT_LON=

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Run `python blinkit_watch.py --chat-id` after messaging your bot once
TELEGRAM_CHAT_ID=

# Optional
QUERIES=hot wheels
KEYWORDS=
INTERVAL=60
MAX_PAGES=4

# Set to 1 only if this folder is a git clone of your GitHub repo.
# Shares state.json with the GitHub Actions watcher so you never get
# the same restock alert twice. Leave 0 if you don't use GitHub.
SYNC_GIT=0
